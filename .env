# PostgreSQL Docker Configuration (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_DB=music_market

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection Settings (used by Node.js app to connect to host port 5434)
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=1234
DB_NAME=music_market

# JWT Authentication Settings
JWT_SECRET=super_secret_jwt_key_music_market_2026
JWT_EXPIRES_IN=7d
